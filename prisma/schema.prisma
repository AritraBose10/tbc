generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Generic key-value store for Petpooja runtime configuration.
// The most critical key is "restID" — received via the Push Menu webhook
// and required in every Save Order call. "storeOpen" is also stored here.
model PetpoojaConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Mirrors the item catalogue delivered by Petpooja's Push Menu webhook.
// petpoojaId is the item ID that must be sent back verbatim in Save Order
// item.id — it is NOT interchangeable with our internal menu IDs.
model MenuItem {
  petpoojaId   String        @id          // Petpooja's canonical item ID
  name         String
  price        Float
  isAvailable  Boolean       @default(true)
  categoryId   String        @default("")
  categoryName String        @default("")
  rawJson      String                      // Full item JSON blob from Push Menu (for audit / debugging)
  updatedAt    DateTime      @updatedAt
  variants     MenuVariant[]
  addons       MenuAddon[]
}

model MenuVariant {
  id             Int      @id @default(autoincrement())
  petpoojaId     String   @unique  // variation.id  → used as order item id
  variationId    String   @default("")  // variation.variationid → used as variation_id in order
  name           String
  price          Float
  item           MenuItem @relation(fields: [itemPetpoojaId], references: [petpoojaId])
  itemPetpoojaId String
}

model MenuAddon {
  id             Int      @id @default(autoincrement())
  petpoojaId     String   @unique
  name           String
  price          Float
  groupId        String   @default("")
  groupName      String   @default("")
  item           MenuItem @relation(fields: [itemPetpoojaId], references: [petpoojaId])
  itemPetpoojaId String
}

model TaxConfig {
  id         Int    @id @default(autoincrement())
  petpoojaId String @unique
  title      String
  type       String
  percentage Float
}

// Audit log of every order-status callback received from Petpooja.
// We respond HTTP 200 immediately; this table is written asynchronously.
// Use orderId to join with your Orders table when that model is added.
model OrderCallback {
  id           Int      @id @default(autoincrement())
  orderId      String                               // Our internal order ID (echoed back by Petpooja)
  status       String                               // Human-readable status, e.g. "accepted", "dispatched"
  prepTime     Int?                                 // Captured from 'minimum_prep_time' in webhook
  deliveryTime Int?                                 // Captured from 'minimum_delivery_time' in webhook
  rawJson      String                               // Full callback payload for debugging
  receivedAt   DateTime @default(now())

  // Relation to Order
  order        Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Order {
  id              String          @id // Unique ID (e.g. tbc-...)
  customerName    String
  customerPhone   String
  customerAddress String
  totalAmount     Float
  status          String          @default("pending") // Overall status derived from callbacks
  orderType       String          @default("H")       // "H" = Delivery, "P" = Takeaway
  tokenNumber     String?                             // E.g. "4829"
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           OrderItem[]
  callbacks       OrderCallback[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name      String
  quantity  Int
  price     Float   // Base unit price at time of order (excluding addons)
  addons    String  @default("[]") // JSON: [{name, price}]
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @unique
  phone     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpSession {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

// Sliding-window rate limit counters. One row per key (e.g. "otp:ip:1.2.3.4").
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
